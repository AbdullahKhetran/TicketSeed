# ============================================
# TicketSeed - ENVIRONMENT VARIABLES
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (which is in .gitignore)
#    Command: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# --- LLM provider selection ---
# Supported values: groq
# Required — no default, the app will error on startup if unset
LLM_PROVIDER=groq

# ============================================
# GROQ (sole provider — free, no card required)
# Get your free API key at: https://console.groq.com
# Sign up -> API Keys -> Create API Key
# ============================================
GROQ_API_KEY=
# Optional: default model shown below, DO NOT change unless you know it is also free
GROQ_MODEL_ID=qwen/qwen3.8-27b

# --- Optional tuning ---
# Maximum PRD length in characters before the API rejects the request (default 30000)
MAX_PRD_CHARS=30000

# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Use process.env.VARIABLE_NAME to access values
# - Never share credentials with AI assistants like Bob
# ============================================